-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS")
    hl.exec_cmd("~/.config/hypr/scripts/audio.sh &")
    hl.exec_cmd('sh -c "sudo ~/.config/hypr/scripts/resolv &"')

    hl.exec_cmd("/usr/lib/xdg-desktop-portal-hyprland &")
    hl.exec_cmd("/usr/lib/xdg-desktop-portal-gtk &")
    hl.exec_cmd("/usr/lib/xdg-desktop-portal &")
    hl.exec_cmd("/usr/lib/hyprpolkitagent &")

    hl.exec_cmd("hyprpaper &")
    -- hl.exec_cmd("waybar &")
    hl.exec_cmd("dunst &")
    hl.exec_cmd("hypridle &")

    hl.exec_cmd("wl-paste --watch clipvault store --min-entry-length 0 --max-entries 20000 --max-entry-age 5d &")
    hl.exec_cmd("wl-paste -p --watch wl-copy &")

    hl.exec_cmd('sh -c "sudo dell-bios-fan-control 0"')
    hl.exec_cmd('sh -c "sudo i8kmon"')
end)

